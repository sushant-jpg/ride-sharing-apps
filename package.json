{
  "name": "ride-nepaljung",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n api,passenger,driver,admin -c green,blue,magenta,yellow \"npm run dev -w server\" \"npm run dev -w apps/passenger-web\" \"npm run dev -w apps/driver-web\" \"npm run dev -w apps/admin-web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test -w server",
    "lint": "eslint .",
    "seed": "npm run seed -w server",
    "db": "docker compose up -d mongo mongo-init",
    "format": "prettier --write \"{apps,server,shared,scripts}/**/*.{js,jsx,css,json}\" \"*.{json,js,md,yml}\" \"docs/*.md\"",
    "setup": "node scripts/setup.js",
    "demo": "node scripts/demo.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "concurrently": "^9.2.0",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.0"
  }
}
